OPENAI_API_KEY=sk-replace-me

# Folder for downloads that are too large to publish: the paper database,
# the abstract file, and embedding caches. Defaults to data/ inside this repo.
# CAUSAL_VARIANT_DATA=

# Folder that holds the trait-match score files used while building questions.
# TRAIT_SCORES_DIR=

# Folder of saved query vectors. Defaults to the cache under CAUSAL_VARIANT_DATA.
# EMBED_CACHE=

# Folder of the files used by the two early checks.
# EARLY_CHECK_DATA=
